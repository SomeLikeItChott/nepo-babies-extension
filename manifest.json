{
  "manifest_version": 3,
  "name": "Nepo Baby Detector for Letterboxd",
  "version": "1.0.0",
  "description": "Flags actors on Letterboxd who have a notable parent.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/film/*",
        "https://www.letterboxd.com/film/*",
        "https://letterboxd.com/actor/*",
        "https://www.letterboxd.com/actor/*"
      ],
      "js": ["dist/content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/nepo-babies.json.gz"],
      "matches": ["https://letterboxd.com/*"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://somelikeitchott.github.io/nepo-babies-scraper/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "nepo-baby-detector@somelikeitchott.github.io",
      "strict_min_version": "113.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
